# Copy to .env to override defaults. Never put real credentials in this file or in source control.
# Port for the local web server
PORT=3120
# Folder for data/db.json, backups and uploaded attachments
CRM_DATA_DIR=./data
# Email transport. Only "demo-sink" exists in this increment: messages are stored in the outbox
# with status "Stored in demo sink – not delivered" and are never sent externally.
EMAIL_TRANSPORT=demo-sink
